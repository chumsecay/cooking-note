# Cooking Note - Cấu hình Cloud Endpoint AI & Backend v2
# File này được nạp tự động khi build ứng dụng với Gradle.
# Copy file này thành .env để cấu hình cho môi trường cục bộ.

# Provider AI mặc định: OPENAI_CHAT (Chat Completions: /v1/chat/completions)
AI_PROVIDER=OPENAI_CHAT

# Base URL của máy chủ đám mây (OpenAI hoặc proxy backend v2 chuẩn OpenAI)
AI_BASE_URL=https://api.openai.com/v1/

# Model AI sử dụng
AI_MODEL=gpt-4o-mini

# API Key mặc định (Nếu dùng proxy backend v2 tự xác thực thì có thể để trống)
AI_API_KEY=

# Số token tối đa cho mỗi phản hồi (256 - 8192)
AI_MAX_TOKENS=1500
